<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <!--
      Replaced SixLabors.ImageSharp (see git history): 4.x added a build-time license check with
      no free path for a closed-source-looking CI/Docker pipeline to satisfy without registering,
      committing, and yearly renewing a key file, and staying on 3.x forever is not a plan.
      SkiaSharp is MIT with no such check, under active co-maintenance by the .NET team and Uno
      Platform. NativeAssets.Linux.NoDependencies covers the Linux and Alpine (musl) native asset
      this project needs at runtime, without Fontconfig - cover images are only decoded, resized
      and re-encoded here, never drawn with text.
    -->
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AudiobookManager.Domain\AudiobookManager.Domain.csproj" />
    <ProjectReference Include="..\AudiobookManager.FileManager\AudiobookManager.FileManager.csproj" />
    <ProjectReference Include="..\AudiobookManager.Scraping\AudiobookManager.Scraping.csproj" />
    <ProjectReference Include="..\AudiobookManager.Settings\AudiobookManager.Settings.csproj" />
  </ItemGroup>

</Project>
